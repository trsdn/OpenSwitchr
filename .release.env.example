# Local build configuration. Copy to .release.env, which is gitignored.
#
# This file holds no notarization credentials on purpose. Signing and
# notarization for published builds happen in the notarization broker, which
# is the only place Apple credentials exist. See RELEASE_CHECKLIST.md.

# Identity used by scripts/build-app.sh for local, unpublished builds.
# Either a certificate SHA-1 fingerprint or a substring of the identity name.
OPENSWITCHR_SIGNING_IDENTITY=
